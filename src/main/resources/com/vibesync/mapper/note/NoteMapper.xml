<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vibesync.note.mapper.NoteMapper">

<!-- ResultMap -->
<resultMap id="noteDetailResultMap" type="com.vibesync.note.domain.NoteDetailDTO">
        <id property="noteIdx" column="note_idx"/>
        <result property="categoryIdx" column="category_idx"/>
        <result property="title" column="title"/>
        <result property="text" column="text"/>
        <result property="createAt" column="create_at"/>
        <result property="editAt" column="edit_at"/>
        <result property="viewCount" column="view_count"/>
        <result property="likeCount" column="like_count"/>
        <association property="member" javaType="com.vibesync.member.domain.MemberVO">
            <id property="acIdx" column="ac_idx"/>
            <result property="nickname" column="nickname"/>
            <result property="img" column="img"/>
        </association>
    </resultMap>
<!-- // -->

<!-- 새 노트 저장 -->
<!-- int insert(NoteVO note); -->
	<insert id="insert" parameterType="com.vibesync.note.domain.NoteVO">
        INSERT INTO note (
        	note_idx, ac_idx, category_idx, parent_note_idx, title, text,
        	display_order
        )
        VALUES (
        	#{noteIdx}, #{acIdx}, #{categoryIdx}, #{parentNoteIdx, jdbcType=INTEGER}, #{title}, #{text},
        	#{displayOrder}
        )
    </insert>
<!-- // -->

<!-- 기존 노트 수정 -->
<!-- int update(NoteVO note); -->
    <update id="update" parameterType="com.vibesync.note.domain.NoteVO">
        UPDATE note
        SET
            title = #{title},
            text = #{text},
            category_idx = #{categoryIdx},
            edit_at = SYSDATE
        WHERE
            note_idx = #{noteIdx}
    </update>
<!-- // -->

<!-- 노트 삭제 -->
<!-- int delete(int noteIdx); -->
	<delete id="delete">
		DELETE FROM note WHERE note_idx = #{noteIdx}
	</delete>
<!-- // -->

<!-- ID로 노트 상세 정보 조회 (작성자 정보 포함) -->
<!-- NoteDetailDTO findNoteDetailByIdx(int noteIdx); -->
    <select id="findNoteDetailByIdx" resultMap="noteDetailResultMap">
        SELECT
            n.note_idx, n.category_idx, n.title, n.text, n.create_at, n.edit_at,
            n.view_count, n.like_count,
            u.ac_idx, u.nickname, u.img
        FROM
            note n
        JOIN
            userAccount u ON n.ac_idx = u.ac_idx
        WHERE
            n.note_idx = #{noteIdx}
    </select>
<!-- // -->

<!-- note_seq의 다음 시퀀스 값 미리 조회 -->
<!-- int selectNextNoteIdx(); -->
	<select id="selectNextNoteIdx" resultType="int">
		SELECT note_seq.NEXTVAL FROM dual
	</select>
<!-- // -->

<!-- 하위 노트 추가 시 마지막 순서(displayOrder) 조회 -->
<!-- int getLastDisplayOrder(int parentNoteIdx) -->
<select id="getLastDisplayOrder" resultType="int">
    SELECT NVL(MAX(display_order), 0) 
    FROM note 
    WHERE parent_note_idx = #{parentNoteIdx}
</select>
<!-- // -->

<!-- 하위 노트 목록 -->
<!-- List<ChildNoteListDTO> findChildNotesByParentIdx(int parentNoteIdx); -->
<select id="findChildNotesByParentIdx" resultType="com.vibesync.note.domain.ChildNoteListDTO">
    SELECT
        note_idx,
        title
    FROM
        note
    WHERE
        parent_note_idx = #{parentNoteIdx}
    ORDER BY
        display_order
</select>
<!-- // -->

<!-- displayOrder 업데이트 -->
<!-- void updateDisplayOrder(int noteIdx, int displayOrder); -->
<update id="updateDisplayOrder">
    UPDATE note
    SET display_order = #{displayOrder}
    WHERE note_idx = #{noteIdx}
</update>
<!-- // -->

</mapper>